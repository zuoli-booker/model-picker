# 系统文件
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# 环境与密钥（BYOK 项目铁律：任何密钥不入库）
.env
.env.*
*.key
secrets/

# 编辑器/智能体工作目录（各智能体的私有工作记忆，不入公开库）
# 例外：.trae/rules/ 是 Trae 的项目规则指针文件，需要入库共享
.idea/
.vscode/
.workbuddy/
.workbuddy-ai/
.claude/
.trae/*
!.trae/rules/
.qoder/
.qwenwork/

# 构建产物
dist/
build/
*.log

# model-picker 运行产物（用户在自己目录运行生成的文件，不入库）
model-picker-config.yaml
my-strategy.md
